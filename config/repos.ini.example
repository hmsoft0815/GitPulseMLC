# GitPulseMLC Configuration Example

[projects]
# Quickest way to create your own: gitpulse init ~/code
# Format: Project Name = Absolute Filesystem Path
# GitPulseMLC will warn if the path ends in '.git' and automatically adjust.
webshop = /home/me/code/webshop
my-website = /home/me/www/personal-site
backend-api = /home/me/code/core-service

[general]
# Optional: Shorten deep paths in the output
# This will replace "/home/me" with "~" in the TUI and reports.
replace_path_prefix = /home/me
replace_with = ~

[settings]
# Minimum width for the NAME column (default: 25)
column_name_width = 30

# Show the final summary block (default: true)
show_summary = true

# Only show repositories that need action (default: false)
# Action required = Dirty state, Ahead/Behind commits, or Stashes.
compact_mode = false

# Git hosts that are private although they look external, as glob patterns.
# gitpulse never checks these online. File paths, hosts without a dot,
# .local/.lan/.home/.internal/.fritz.box and private IPs are local anyway.
# private_hosts = git.example.com, *.corp.example

# Remotes that are yours: a host, or host/owner; * matches within a segment.
# `gitpulse add` puts repositories with remotes elsewhere into [third_party].
# A repository with no remote or a local-network remote is always yours.
# own_remotes = github.com/me, gitlab.com/my-group, git.example.com

# Terminal table (default: auto). auto fits the terminal: wide → narrow (no PATH,
# short branch names) → stacked (two lines per repository). Pipes stay wide.
# layout = auto

[third_party]
# Other people's repositories, checked out to look at or test.
# Local changes here are hints, not action items; `gitpulse mark NAME 3rd|own` moves them.
# whisper.cpp = /home/me/src/whisper.cpp

[disabled_projects]
# Ignored: not scanned, and `gitpulse add` will not add them again.
# `gitpulse ignore NAME` puts a project here, `gitpulse watch NAME` takes it back.
# old-tool = /home/me/code/old-tool
