# Copy to .release.env (git-ignored) and fill in. Used by `task sign:macos`
# and `task publish:downloads`; the keychain password is never stored here —
# export MAC_KEYCHAIN_PASS in your shell instead.

# SSH target of the Mac that signs and notarizes (user@host)
MAC_HOST=
# codesign identity in quotes, e.g. "Developer ID Application: Your Name (TEAMID)"
SIGN_ID=
# notarytool keychain profile created with `xcrun notarytool store-credentials`
NOTARY_PROFILE=
# rsync target for the public downloads (user@host:/path)
DOWNLOAD_TARGET=
